{
  "name": "tbdataexplorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:types": "wrangler types --env-interface PagesEnv worker-configuration.d.ts",
    "pretypecheck": "npm run cf:types",
    "prebuild": "npm run cf:types",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr scripts/generate-seo.tsx --outDir .wrangler/seo-build && node .wrangler/seo-build/generate-seo.js",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler/functions-build",
    "build:guard": "wrangler deploy --config wrangler.guard.jsonc --dry-run --outdir .wrangler/guard-build",
    "deploy:guard": "wrangler deploy --config wrangler.guard.jsonc",
    "test:guard": "npm run build:guard && node scripts/test-proxy-guard.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run catalog:validate && npm run access:validate && npm run discovery:validate && npm run typecheck && npm run lint && npm run test:coverage && npm run test:guard && npm run test:e2e",
    "test:e2e": "playwright test",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "access:audit": "node scripts/audit-access.mjs",
    "access:validate": "tsx scripts/validate-access.ts",
    "discovery:refresh": "tsx scripts/refresh-discovery.ts",
    "discovery:validate": "tsx scripts/validate-discovery.ts",
    "deploy": "npm run build && npm run deploy:guard && wrangler pages deploy dist --project-name=tbdataexplorer",
    "catalog:categorize": "tsx scripts/categorize-catalog.ts",
    "category:evaluate": "tsx scripts/evaluate-categories.ts",
    "category:semantic:evaluate": "tsx scripts/evaluate-semantic-categories.ts",
    "category:benchmark": "tsx scripts/benchmark-categories.ts"
  },
  "dependencies": {
    "@terraformer/arcgis": "^2.1.2",
    "fuse.js": "^7.1.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@huggingface/transformers": "^4.3.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.0.0",
    "miniflare": "5.20261103.0-beta",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
